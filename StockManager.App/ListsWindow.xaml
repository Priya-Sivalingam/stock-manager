<Window x:Class="StockManager.App.ListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categories and Suppliers" Height="440" Width="640"
        WindowStartupLocation="CenterOwner">
    <TabControl Margin="12">
        <TabItem Header="Categories">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" Margin="0,0,12,0" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Category name *"/>
                    <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="New" Command="{Binding NewCategoryCommand}" Width="70" Margin="0,0,8,0"/>
                        <Button Content="Save" Command="{Binding SaveCategoryCommand}" Width="70" Margin="0,0,8,0"/>
                        <Button Content="Delete" Command="{Binding DeleteCategoryCommand}" Width="70"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CategoryMessage}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Suppliers">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" Margin="0,0,12,0" ItemsSource="{Binding Suppliers}"
                         SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Supplier name *"/>
                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                    <TextBlock Text="Phone"/>
                    <TextBox Text="{Binding SupplierPhone}" Margin="0,2,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="New" Command="{Binding NewSupplierCommand}" Width="70" Margin="0,0,8,0"/>
                        <Button Content="Save" Command="{Binding SaveSupplierCommand}" Width="70" Margin="0,0,8,0"/>
                        <Button Content="Delete" Command="{Binding DeleteSupplierCommand}" Width="70"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SupplierMessage}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>