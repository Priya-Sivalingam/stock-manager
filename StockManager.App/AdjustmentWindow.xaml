<Window x:Class="StockManager.App.AdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment" Height="560" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Width="360" HorizontalAlignment="Left">
            <TextBlock Text="Product *"/>
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                      DisplayMemberPath="Name" Margin="0,2,0,8"/>

            <TextBlock Text="{Binding CurrentStock, StringFormat=System stock: {0}}"
                       FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Text="Actual counted quantity *"/>
            <TextBox Text="{Binding CountedQty, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

            <TextBlock Text="Reason *"/>
            <ComboBox IsEditable="True" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12">
                <ComboBoxItem Content="Stock count"/>
                <ComboBoxItem Content="Damaged"/>
                <ComboBoxItem Content="Expired"/>
                <ComboBoxItem Content="Lost / missing"/>
                <ComboBoxItem Content="Found"/>
            </ComboBox>

            <Button Content="Save adjustment" Command="{Binding SaveCommand}" Width="130" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding Message}" Margin="0,8,0,12" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Recent}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
                <DataGridTextColumn Header="Change" Binding="{Binding Change}"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>