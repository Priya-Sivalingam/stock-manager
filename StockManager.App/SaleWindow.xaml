<Window x:Class="StockManager.App.SaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Sale" Height="560" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Scan barcode or type SKU, then Enter"/>
                <TextBox x:Name="ScanBox" Width="300" Margin="0,2,0,0"
                         Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddItemCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Qty"/>
                <TextBox Width="60" Margin="0,2,0,0" Text="{Binding AddQty}"/>
            </StackPanel>
            <CheckBox Content="Wholesale prices" IsChecked="{Binding IsWholesale}"
                      VerticalAlignment="Bottom" Margin="0,0,12,4"/>
            <Button Content="Add" Command="{Binding AddItemCommand}" Width="70"
                    VerticalAlignment="Bottom"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedLine}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}"/>
                <DataGridTextColumn Header="Item" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}"/>
                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding Total, StringFormat=Total: {0:N2}}" FontSize="22" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Remove selected" Command="{Binding RemoveLineCommand}" Width="130" Margin="0,0,8,0"/>
                <Button Content="Complete sale" Command="{Binding CompleteSaleCommand}" Width="130"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>