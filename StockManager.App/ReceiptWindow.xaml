<Window x:Class="StockManager.App.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Goods Receipt" Height="560" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Width="360" HorizontalAlignment="Left">
            <TextBlock Text="Product *"/>
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                      DisplayMemberPath="Name" Margin="0,2,0,8"/>

            <TextBlock Text="{Binding CurrentStock, StringFormat=Current stock: {0}}"
                       FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Text="Quantity received *"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

            <TextBlock Text="Unit cost"/>
            <TextBox Text="{Binding UnitCost, StringFormat=N2}" Margin="0,2,0,8"/>

            <TextBlock Text="Reference (supplier invoice / PO no.)"/>
            <TextBox Text="{Binding Reference}" Margin="0,2,0,12"/>

            <Button Content="Receive stock" Command="{Binding ReceiveCommand}" Width="120" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding Message}" Margin="0,8,0,12" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Recent}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}"/>
                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>