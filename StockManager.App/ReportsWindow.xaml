<Window x:Class="StockManager.App.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports" Height="560" Width="820"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="FromDate" Width="120" Margin="0,0,12,0"/>
            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="ToDate" Width="120" Margin="0,0,12,0"/>
            <Button Content="Refresh" Click="Refresh_Click" Width="80" Margin="0,0,8,0"/>
            <Button Content="Export to CSV" Click="Export_Click" Width="110"/>
        </StackPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="Stock valuation">
                <DockPanel Margin="8">
                    <TextBlock x:Name="StockTotal" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Sales">
                <DockPanel Margin="8">
                    <TextBlock x:Name="SalesTotal" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Qty sold" Binding="{Binding Qty}"/>
                            <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Est. profit" Binding="{Binding Profit, StringFormat=N2}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>